# MoneyOS gasless v1 Path C Sepolia rehearsal template
# SAFE TEMPLATE ONLY. Never commit real secrets.

# Required for forge/cast commands.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Sponsor wallet pays gas and optionally funds native send value.
# Use a throwaway key.
SEPOLIA_SPONSOR_PK=0xREPLACE_WITH_THROWAWAY_SPONSOR_PRIVATE_KEY

# Owner wallet signs the intent payload (does not need gas for these scripts).
# Can also be a throwaway key.
SEPOLIA_OWNER_PK=0xREPLACE_WITH_THROWAWAY_OWNER_PRIVATE_KEY
