{
  "name": "@moneyos/executor-particle",
  "version": "0.1.0",
  "description": "Particle Network smart-account execution adapter for MoneyOS — gasless sponsored transactions on Arbitrum via ERC-4337",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "keywords": ["moneyos", "particle", "aa", "erc-4337", "gasless", "paymaster"],
  "author": "Aryze",
  "license": "MIT",
  "files": ["dist"],
  "dependencies": {
    "@particle-network/aa": "^1.0.0"
  },
  "peerDependencies": {
    "@moneyos/core": ">=0.1.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "vitest": "^3.1.1"
  }
}
