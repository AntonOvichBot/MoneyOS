{
  "name": "moneyos",
  "version": "0.4.0",
  "description": "The operating system for money. Programmable money primitives for developers and AI agents.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "moneyos": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:prepare": "npm run build:core && npm run build:swap",
    "test": "npm run test:prepare && vitest run",
    "test:coverage": "npm run test:prepare && vitest run --coverage",
    "test:watch": "npm run test:prepare && vitest",
    "build:core": "npm run build --workspace=packages/core",
    "typecheck:core": "npm run typecheck --workspace=packages/core",
    "lint:core": "npm run lint --workspace=packages/core",
    "build:swap": "npm run build --workspace=packages/swap",
    "typecheck:swap": "npm run typecheck --workspace=packages/swap",
    "lint:swap": "npm run lint --workspace=packages/swap"
  },
  "keywords": [
    "money",
    "payments",
    "crypto",
    "stablecoin",
    "wallet",
    "sdk",
    "cli",
    "agent",
    "ai",
    "web3"
  ],
  "author": "Aryze",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1231CheGites/MoneyOS.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "commander": "^13.1.0",
    "viem": "^2.45.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@moneyos/core": "workspace:*",
    "@moneyos/swap": "workspace:*",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.25.1",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.1.1"
  }
}
